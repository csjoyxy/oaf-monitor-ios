#!/bin/sh /etc/rc.common
# /etc/init.d/oaf-bark

START=99
STOP=15
USE_PROCD=1

PROG="/usr/bin/oaf-barkd"

start_service() {
    local enabled
    config_load oaf_bark
    config_get_bool enabled @global[0] enabled 0
    [ "$enabled" -eq 1 ] || {
        # Fallback check via uci if named differently
        enabled="$(uci -q get oaf_bark.@global[0].enabled || echo 0)"
        [ "$enabled" = "1" ] || return 0
    }

    procd_open_instance
    procd_set_param command /usr/bin/lua "$PROG"
    procd_set_param respawn 3600 10 5
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "oaf_bark"
}
