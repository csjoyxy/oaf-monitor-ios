{
  "oaf-bark": {
    "description": "Grant ubus access to OAF 7.0 statistics, Bark notifier, and false-positive feature manager for OAF Pulse",
    "read": {
      "uci": ["fwx", "oaf_bark"],
      "ubus": {
        "fwx": ["common"],
        "oaf_bark": ["get_config", "test_push", "inspect_feature"]
      }
    },
    "write": {
      "uci": ["oaf_bark"],
      "ubus": {
        "fwx": ["common"],
        "oaf_bark": [
          "set_config",
          "toggle_device",
          "test_push",
          "clear_events",
          "toggle_ignore_app",
          "inspect_feature",
          "set_feature_rule",
          "restore_all_features"
        ]
      }
    }
  }
}
